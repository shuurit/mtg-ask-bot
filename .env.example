# Copy this file to .env for register-commands.js (never commit the real .env file).
# Only used locally to register the slash command -- never read by the Worker itself.

# Discord Developer Portal -> your app -> General Information -> Application ID
DISCORD_APPLICATION_ID=your-discord-application-id

# Discord Developer Portal -> your app -> Bot -> Reset Token -> Token
# Treat this as a secret: regenerate it immediately if it's ever exposed.
DISCORD_BOT_TOKEN=your-discord-bot-token

# Optional: register the /ask command to one server only, for instant testing.
# Discord -> enable Developer Mode -> right-click your server icon -> Copy Server ID.
# Leave unset to register the command globally instead (can take up to an hour to propagate).
DISCORD_GUILD_ID=your-discord-guild-id
